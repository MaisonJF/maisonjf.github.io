# Copy to .env.observe locally. Never commit real secrets.

POSTGRES_USER=osiris
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=osiris
POSTGRES_PORT=5432
REDIS_PORT=6379

# Osiris Memory source is pinned for reproducibility.
OSIRIS_REF=181658e1db85ce4d2e8702124423b674b3cb136f
UV_VERSION=0.12.18
OSIRIS_MCP_PORT=8790
MAISON_OSIRIS_BRIDGE_PORT=8791
BRAIN_MCP_HOST_PORT=8792
MAISON_OSIRIS_BRIDGE_TOKEN=CHANGE_ME_LONG_RANDOM

# Semantic Memory uses the separate maison_memory DB on the same PostgreSQL server.
MAISON_SEMANTIC_DATABASE_URL=postgresql://osiris:CHANGE_ME_LONG_RANDOM@127.0.0.1:5432/maison_memory

# No external provider keys belong in this file by default.

# Optional authenticated read-only D1 control API. Keep disabled remotely until explicitly activated.
BRAIN_CONTROL_API_URL=https://REPLACE_WITH_PRIVATE_WORKER_HOST
BRAIN_CONTROL_TOKEN=CHANGE_ME_LONG_RANDOM
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional explicit territory policies; never infer missing commercial economics.
MAISON_BRAIN_TERRITORY_POLICY_JSON={}
MAISON_PREBRAIN_SIMILARITY=0.45
MAISON_PREBRAIN_MIN_ROOTS=2
MAISON_SCOUT_MIN_CONFIDENCE=0.60

# Optional read-only memory context for the one-shot Brain cycle.
MAISON_SEMANTIC_CONTEXT_ENABLED=false
MAISON_OSIRIS_CONTEXT_ENABLED=false
MAISON_MEMORY_CONTEXT_MAX_TERRITORIES=8
MAISON_MEMORY_CONTEXT_LIMIT=5
MAISON_OSIRIS_CONTEXT_MAX_DEPTH=1
OSIRIS_PROJECT=

# Manual D1 -> pgvector projection sync. Provider prefixes are explicit privacy allowlist.
MAISON_SEMANTIC_SYNC_PROVIDER_PREFIXES=eurostat_
MAISON_SEMANTIC_SYNC_PAGE_SIZE=100
MAISON_SEMANTIC_SYNC_MAX_PAGES=20

# Optional PRIVATE stock/cost/capacity overlay. Keep the actual file outside git.
MAISON_COMMERCIAL_ASSET_OVERLAY_PATH=

# Optional narrow proposal write surface. Separate token from read-only Brain Control API.
BRAIN_PROPOSAL_API_URL=https://REPLACE_WITH_PRIVATE_WORKER_HOST
BRAIN_PROPOSAL_TOKEN=CHANGE_ME_LONG_RANDOM
MAISON_A14_MATERIALIZE_ENABLED=false
MAISON_A14_MATERIALIZE_STATES=enrichment_required,human_review_preview

# Human commercial review decision surface. Separate authority/token.
BRAIN_REVIEW_DECISION_API_URL=https://REPLACE_WITH_PRIVATE_WORKER_HOST
BRAIN_REVIEW_DECISION_TOKEN=CHANGE_ME_LONG_RANDOM
MAISON_REVIEW_DECISION_ENABLED=false

# Approved A12 review -> A14.3 validation planning. Preview by default.
MAISON_VALIDATION_PLAN_MATERIALIZE_ENABLED=false
MAISON_VALIDATION_PLAN_LIMIT=50

# A7-gated CTA validation -> A8 draft only. Requires runtime/.private/cta-context.json.
MAISON_A8_DRAFT_MATERIALIZE_ENABLED=false
MAISON_A8_DRAFT_LIMIT=50
