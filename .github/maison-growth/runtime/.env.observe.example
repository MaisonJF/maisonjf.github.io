# Copy to .env.observe locally. Never commit real secrets.

POSTGRES_USER=osiris
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=osiris
POSTGRES_PORT=5432
REDIS_PORT=6379

# Osiris Memory source is pinned for reproducibility.
OSIRIS_REF=181658e1db85ce4d2e8702124423b674b3cb136f
UV_VERSION=0.12.18
OSIRIS_MCP_PORT=8790
MAISON_OSIRIS_BRIDGE_PORT=8791
MAISON_OSIRIS_BRIDGE_TOKEN=CHANGE_ME_LONG_RANDOM

# Semantic Memory uses the separate maison_memory DB on the same PostgreSQL server.
MAISON_SEMANTIC_DATABASE_URL=postgresql://osiris:CHANGE_ME_LONG_RANDOM@127.0.0.1:5432/maison_memory

# No external provider keys belong in this file by default.
