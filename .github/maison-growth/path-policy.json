{
  "policy_version": "A0.4",
  "default_repo_write": "deny",
  "precedence": "deny_overrides_allow",
  "protected_paths": [
    ".github/workflows/**",
    "_redirects",
    "functions/api/**",
    "functions/_lib/**",
    "checkout*.html",
    "checkout-*.html",
    "informacao-legal.html",
    "robots.txt",
    "CNAME",
    "2e7132dc5767b64308add20a2790e2b6.txt"
  ],
  "protected_capabilities": [
    "price_change",
    "discount_change",
    "checkout_change",
    "payment_logic_change",
    "commercial_promise_change",
    "paid_content_publication",
    "legal_policy_change",
    "infrastructure_change"
  ],
  "actions": {
    "internal_analysis": {
      "repo_write": false,
      "allowed_paths": []
    },
    "internal_candidate_create": {
      "repo_write": false,
      "runtime_store": "D1:ocean_memory_signals/ocean_memory_state",
      "github_role": "derived_snapshot_only",
      "entry_policy": "persist_first_filter_later",
      "constraints": [
        "no_public_page_creation",
        "no_sitemap_or_navigation_change",
        "no_personal_or_sensitive_data",
        "no_private_conversation_content",
        "no_paid_oracle_content",
        "no_paid_body_content_in_repo",
        "automatic_publication_forbidden"
      ]
    },
    "commercial_candidate_create": {
      "repo_write": false,
      "allowed_paths": []
    },
    "cta_experiment": {
      "repo_write": "publisher_gateway_only",
      "requires_explicit_target_asset": true,
      "requires_snapshot": true,
      "requires_rollback_plan": true,
      "may_change": [
        "approved_cta_destination_reference"
      ],
      "may_not_change": [
        "price",
        "discount",
        "checkout",
        "product_definition",
        "commercial_promise",
        "paid_content",
        "legal_content"
      ]
    },
    "ocean_promotion": {
      "repo_write": "publisher_gateway_only",
      "create_only_content_roots": [
        "relacoes/",
        "cabeca/",
        "decisoes/",
        "casa/",
        "corpo/",
        "companhia/",
        "presentes/",
        "tarot/",
        "espiritualidade/",
        "trabalho/",
        "dinheiro/",
        "respostas/"
      ],
      "may_create": [
        "<approved-content-root>/<new-slug>.html",
        "sitemap-oceans-*.xml"
      ],
      "may_update": [
        "sitemap.xml"
      ],
      "may_not_modify_existing_content": true,
      "requires_new_path": true,
      "requires_hard_gates_pass": true,
      "requires_evidence_sources_min": 2,
      "requires_oceans_guard_pass": true
    },
    "ocean_intelligence_persist": {
      "repo_write": false,
      "runtime_store": "D1:ocean_memory_signals/ocean_memory_state/ocean_memory_alerts",
      "authority": "permanent_human_authorization_2026-09-25",
      "github_role": "asynchronous_snapshot_and_audit_only",
      "entry_policy": "persist_first_filter_later",
      "canonical_promotion_policy": "downstream_gate",
      "constraints": [
        "analyse_existing_oceans_after_ingest_before_canonical_promotion",
        "if_semantically_similar_enrich_canonical_ocean_instead_of_creating_clone",
        "preserve_existing_human_review_state",
        "minimum_independent_evidence_sources_2_for_canonical_promotion_not_ingest",
        "deduplicate_evidence_and_theme_candidates_before_promotion",
        "no_personal_or_sensitive_data",
        "no_private_conversation_content",
        "no_paid_body_content",
        "no_automatic_publication"
      ]
    },
    "commercial_recovery_capture": {
      "repo_write": "internal_recovery_only",
      "allowed_paths": [
        ".github/maison-growth/brain/commercial-recovery-contract.json"
      ],
      "authority": "explicit_human_authorization_2026-09-27",
      "constraints": [
        "preservation_only_not_catalogue_authority",
        "capture_before_downstream_write",
        "no_public_write",
        "no_price_checkout_payment_or_legal_change",
        "no_personal_or_sensitive_data",
        "no_private_conversation_content",
        "no_paid_body_content",
        "retry_unresolved_without_erasing_payload",
        "mark_integrated_only_after_destination_readback"
      ]
    },
    "ocean_signal_ingest": {
      "repo_write": false,
      "runtime_store": "D1:ocean_memory_signals",
      "authority": "automatic_internal_observation",
      "evidence_minimum_to_store": 1,
      "duplicate_strategy": "idempotent_payload_hash",
      "constraints": [
        "privacy_safe_payload_only",
        "no_private_conversation_content",
        "no_paid_oracle_content",
        "no_public_write",
        "no_spend",
        "no_outbound_contact"
      ]
    },
    "ocean_snapshot_export": {
      "repo_write": "scheduled_internal_queue_only",
      "allowed_paths": [
        ".github/maison-growth/oceans/candidates.json",
        ".github/maison-growth/brain/editorial-queue.json",
        "functions/_lib/vpc-ocean-signals.generated.js"
      ],
      "source": "D1:ocean_memory_state",
      "failure_policy": "retry_without_blocking_ingest_alerts_or_brain",
      "constraints": [
        "derived_snapshot_only",
        "post_write_readback_verification",
        "retry_after_fresh_read_on_sha_conflict",
        "no_publication_side_effect"
      ]
    }
  },
  "protected_path_exceptions": [
    "functions/_lib/vpc-ocean-signals.generated.js"
  ]
}
