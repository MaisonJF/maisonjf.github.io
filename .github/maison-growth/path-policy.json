{
  "policy_version": "A0.3",
  "default_repo_write": "deny",
  "precedence": "deny_overrides_allow",
  "protected_paths": [
    ".github/workflows/**",
    "_redirects",
    "functions/api/**",
    "functions/_lib/**",
    "checkout*.html",
    "checkout-*.html",
    "informacao-legal.html",
    "robots.txt",
    "CNAME",
    "2e7132dc5767b64308add20a2790e2b6.txt"
  ],
  "protected_capabilities": [
    "price_change",
    "discount_change",
    "checkout_change",
    "payment_logic_change",
    "commercial_promise_change",
    "paid_content_publication",
    "legal_policy_change",
    "infrastructure_change"
  ],
  "actions": {
    "internal_analysis": {
      "repo_write": false,
      "allowed_paths": []
    },
    "internal_candidate_create": {
      "repo_write": "scheduled_internal_queue_only",
      "allowed_paths": [
        ".github/maison-growth/oceans/candidates.json",
        ".github/maison-growth/brain/editorial-queue.json",
        "functions/_lib/vpc-ocean-signals.generated.js"
      ],
      "constraints": [
        "no_public_page_creation",
        "no_sitemap_or_navigation_change",
        "no_personal_or_sensitive_data",
        "no_private_conversation_content",
        "no_paid_oracle_content",
        "deduplicate_before_write",
        "minimum_independent_evidence_sources_2",
        "no_paid_body_content_in_repo",
        "editorial_queue_requires_human_approval",
        "generated_signal_bridge_only"
      ]
    },
    "commercial_candidate_create": {
      "repo_write": false,
      "allowed_paths": []
    },
    "cta_experiment": {
      "repo_write": "publisher_gateway_only",
      "requires_explicit_target_asset": true,
      "requires_snapshot": true,
      "requires_rollback_plan": true,
      "may_change": [
        "approved_cta_destination_reference"
      ],
      "may_not_change": [
        "price",
        "discount",
        "checkout",
        "product_definition",
        "commercial_promise",
        "paid_content",
        "legal_content"
      ]
    },
    "ocean_promotion": {
      "repo_write": "publisher_gateway_only",
      "create_only_content_roots": [
        "relacoes/",
        "cabeca/",
        "decisoes/",
        "casa/",
        "corpo/",
        "companhia/",
        "presentes/",
        "tarot/",
        "espiritualidade/",
        "trabalho/",
        "dinheiro/",
        "respostas/"
      ],
      "may_create": [
        "<approved-content-root>/<new-slug>.html",
        "sitemap-oceans-*.xml"
      ],
      "may_update": [
        "sitemap.xml"
      ],
      "may_not_modify_existing_content": true,
      "requires_new_path": true,
      "requires_hard_gates_pass": true,
      "requires_evidence_sources_min": 2,
      "requires_oceans_guard_pass": true
    },
    "ocean_intelligence_persist": {
      "repo_write": "scheduled_internal_queue_only",
      "allowed_paths": [
        ".github/maison-growth/oceans/candidates.json",
        ".github/maison-growth/brain/editorial-queue.json",
        "functions/_lib/vpc-ocean-signals.generated.js"
      ],
      "authority": "permanent_human_authorization_2026-09-25",
      "duplicate_strategy": "semantic_merge_before_create",
      "constraints": [
        "analyse_existing_oceans_before_write",
        "if_semantically_similar_enrich_canonical_ocean_instead_of_creating_clone",
        "preserve_existing_human_review_state",
        "minimum_independent_evidence_sources_2_for_new_ocean",
        "deduplicate_evidence_and_theme_candidates",
        "no_personal_or_sensitive_data",
        "no_private_conversation_content",
        "no_paid_body_content_in_repo",
        "no_automatic_publication",
        "post_write_readback_verification",
        "retry_after_fresh_read_on_sha_conflict"
      ]
    }
  },
  "protected_path_exceptions": [
    "functions/_lib/vpc-ocean-signals.generated.js"
  ]
}
