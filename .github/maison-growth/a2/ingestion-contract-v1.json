{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maison-growth-ingestion-v1",
  "title": "Maison Growth Event Ingestion Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source",
    "event_type",
    "occurred_at",
    "idempotency_key"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "event_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "journey_id": {"type": ["string", "null"]},
    "asset_id": {"type": ["string", "null"]},
    "need_id": {"type": ["string", "null"]},
    "solution_id": {"type": ["string", "null"]},
    "value_minor": {"type": ["integer", "null"]},
    "currency": {"type": ["string", "null"]},
    "privacy_class": {
      "type": "string",
      "enum": ["anonymous", "pseudonymous", "aggregated", "system"]
    },
    "metadata": {"type": "object"},
    "rule_version_id": {"type": ["string", "null"]},
    "model_version_id": {"type": ["string", "null"]}
  },
  "normalization": {
    "output_schema_version": 2,
    "source": "trim + lowercase",
    "event_type": "trim + lowercase",
    "currency": "trim + uppercase",
    "occurred_at": "RFC3339 normalized to UTC Z",
    "metadata": "source allowlist + canonical JSON",
    "event_id": "generated by collector as evt_ + UUIDv7",
    "payload_hash": "SHA-256 over canonical normalized payload before generated event_id"
  },
  "privacy": {
    "direct_pii": "reject",
    "unknown_metadata": "reject",
    "paid_oracle_text": "reject",
    "commercial_identifiable_data": "reject",
    "raw_free_text": "deny unless a future reviewed source contract explicitly allows a privacy-safe derived field"
  }
}
