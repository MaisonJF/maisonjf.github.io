{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maison-jf.com/schemas/commercial-asset-overlay-v1.json",
  "title": "Maison private commercial asset operational overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "commercial_asset_overlay_v1"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_ref",
          "operational",
          "evidence_refs"
        ],
        "properties": {
          "asset_ref": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "operational": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inventory_quantity": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "reserved_quantity": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "unit_material_cost_minor": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "packaging_cost_minor": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "production_minutes_per_unit": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "batch_capacity_units": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "moq_units": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "shelf_life_days": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "supplier_lead_days": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "capacity_units_per_period": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "capacity_period": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "human_effort_minutes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "variable_cost_minor": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "delivery_lead_days": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
