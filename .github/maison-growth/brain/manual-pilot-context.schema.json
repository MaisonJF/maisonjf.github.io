{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maison-jf.com/schemas/manual-pilot-context-v1.json",
  "title": "Maison private manual pilot context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "contexts"],
  "properties": {
    "schema_version": {"const": "manual_pilot_context_v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["validation_plan_id", "inputs", "evidence_refs"],
        "properties": {
          "validation_plan_id": {
            "type": "string",
            "pattern": "^vpl_.{36}$"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "target_profile": {"type": "string", "minLength": 1, "maxLength": 2000},
              "capacity_basis": {"type": "string", "minLength": 1, "maxLength": 2000},
              "unit_or_project_cost_minor": {"type": "integer", "minimum": 0},
              "price_or_quote_rule": {"type": "string", "minLength": 1, "maxLength": 2000},
              "fulfilment_lead_time_days": {"type": "integer", "minimum": 0},
              "amplifier_or_partner_ref": {"type": "string", "minLength": 1, "maxLength": 2000},
              "activation_strategy": {"type": "string", "minLength": 1, "maxLength": 2000},
              "direct_cost_minor": {"type": "integer", "minimum": 0},
              "attribution_method": {"type": "string", "minLength": 1, "maxLength": 2000},
              "purchase_behaviour": {"type": "string", "minLength": 1, "maxLength": 2000},
              "pilot_scope": {"type": "string", "minLength": 1, "maxLength": 2000},
              "cost_basis": {"type": "string", "minLength": 1, "maxLength": 2000},
              "explicit_new_offer_decision_ref": {"type": "string", "minLength": 1, "maxLength": 2000}
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        }
      }
    }
  }
}
