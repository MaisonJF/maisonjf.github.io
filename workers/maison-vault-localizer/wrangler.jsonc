{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "maison-vault-localizer",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "vars": {
    "LOCALIZER_ENABLED": "true",
    "LOCALIZER_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "LOCALIZER_BATCH_SIZE": "24",
    "LOCALIZER_ROUNDS_PER_CRON": "1",
    "LOCALIZER_QUESTION_BATCH_SIZE": "24",
    "LOCALIZER_ORACLE_BATCH_SIZE": "8",
    "LOCALIZER_BACKFILL_SIZE": "60",
    "LOCALIZER_AI_CHUNK_SIZE": "20"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "GROWTH_DB",
      "database_name": "maison-growth-engine",
      "database_id": "fb49d911-fed3-4c50-8424-231aae391814"
    }
  ]
}
