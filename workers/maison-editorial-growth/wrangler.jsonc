{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "maison-editorial-growth",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "EDITORIAL_GROWTH_ENABLED": "true",
    "ZERO_COST_MODE": "true",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "GROWTH_DB",
      "database_name": "maison-growth-engine",
      "database_id": "fb49d911-fed3-4c50-8424-231aae391814"
    }
  ]
}
