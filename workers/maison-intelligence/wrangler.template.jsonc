{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "maison-intelligence",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "triggers": {
    "crons": [
      "0 * * * *",
      "17 4 * * *"
    ]
  },
  "vars": {
    "WORKER_ENABLED": "false",
    "BRAIN_CONTROL_API_ENABLED": "false",
    "BRAIN_PROPOSAL_API_ENABLED": "false",
    "BRAIN_REVIEW_DECISION_ENABLED": "false",
    "KILL_SWITCH": "true",
    "PROMPTS_PER_RUN": "2",
    "MAX_DAILY_CALLS_PER_PROVIDER": "2",
    "WORKERS_AI_ENABLED": "false",
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "OSIRIS_GATEWAY_ENABLED": "false",
    "OSIRIS_GATEWAY_BASE_URL": "https://ai.osiris-code.com/v1",
    "OSIRIS_GATEWAY_MODEL": "",
    "OSIRIS_MEMORY_ENABLED": "false",
    "OSIRIS_MEMORY_BRIDGE_URL": "",
    "OPENROUTER_ENABLED": "false",
    "OPENROUTER_MODEL": "openrouter/free",
    "OSIRIS_ENABLED": "false",
    "OSIRIS_BASE_URL": "https://osirisai.live",
    "OSIRIS_SOURCE_KEYS": "stats,flights,satellites,space_weather,earthquakes,fires,weather,air_quality,radar,conflicts,frontlines,gdelt,country_risk,news,live_news,markets,crypto,scm_suppliers,cctv,infrastructure,maritime,cyber_threats,cyber_attacks,malware",
    "OSIRIS_SOURCE_CADENCES_JSON": "",
    "MAX_DAILY_CALLS_PER_OSIRIS_SOURCE": "24",
    "PUBLIC_DATA_ENABLED": "false",
    "MAX_DAILY_CALLS_PER_PUBLIC_SOURCE": "4",
    "EUROSTAT_ENABLED": "false",
    "EUROSTAT_QUERIES_JSON": "[]",
    "BASE_PT_ENABLED": "false",
    "BASE_PT_QUERIES_JSON": "[]",
    "OPENALEX_ENABLED": "false",
    "OPENALEX_QUERIES_JSON": "[]",
    "OPENAI_ENABLED": "false",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "GEMINI_ENABLED": "false",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "PERPLEXITY_ENABLED": "false",
    "PERPLEXITY_MODEL": "sonar",
    "ANTHROPIC_ENABLED": "false",
    "ANTHROPIC_MODEL": "",
    "SEARCH_VISIBILITY_ENABLED": "false",
    "GOOGLE_SEARCH_CONSOLE_ENABLED": "false",
    "GOOGLE_SEARCH_CONSOLE_PROPERTY": "sc-domain:maison-jf.com",
    "GOOGLE_SEARCH_CONSOLE_WINDOW_DAYS": "28",
    "GOOGLE_SEARCH_CONSOLE_LAG_DAYS": "3",
    "MAX_DAILY_CALLS_PER_SEARCH_SOURCE": "5",
    "SEARCH_VISIBILITY_PROBES_ENABLED": "false",
    "VISIBILITY_PROBES_PER_RUN": "2",
    "MAX_DAILY_CALLS_PER_VISIBILITY_PROVIDER": "2",
    "BING_WEBMASTER_ENABLED": "false",
    "BING_WEBMASTER_SITE_URL": "https://maison-jf.com/"
  },
  "d1_databases": [
    {
      "binding": "GROWTH_DB",
      "database_name": "maison-growth-engine",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INTELLIGENCE_QUEUE",
        "queue": "maison-intelligence"
      }
    ],
    "consumers": [
      {
        "queue": "maison-intelligence",
        "max_batch_size": 2,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 300,
        "dead_letter_queue": "maison-intelligence-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  }
}
