{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "maison-intelligence",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "0 */3 * * *"
    ]
  },
  "vars": {
    "WORKER_ENABLED": "true",
    "BRAIN_CONTROL_API_ENABLED": "true",
    "OCEAN_MEMORY_ENABLED": "true",
    "OCEAN_MEMORY_ALERT_THRESHOLD": "60",
    "EDITORIAL_CANDIDATE_GENERATION_ENABLED": "true",
    "MAX_DAILY_EDITORIAL_CANDIDATE_CALLS": "2",
    "A2_INGEST_API_ENABLED": "false",
    "A11_LEARNING_WRITE_API_ENABLED": "false",
    "BRAIN_PROPOSAL_API_ENABLED": "false",
    "COMMERCIAL_RECOVERY_API_ENABLED": "false",
    "VIDEO_GENERATION_ENABLED": "true",
    "VIDEO_ZERO_COST_PROVIDERS_JSON": "[{\"id\":\"wan22-aoti-fast\",\"base\":\"https://zerogpu-aoti-wan2-2-fp8da-aoti-faster.hf.space\",\"api\":\"generate_video\",\"protocol\":\"wan22_aoti_9\"},{\"id\":\"wan22-r3gm-preview\",\"base\":\"https://r3gm-wan2-2-fp8da-aoti-preview.hf.space\",\"api\":\"generate_video\",\"protocol\":\"wan22_aoti_9\"}]",
    "BRAIN_REVIEW_DECISION_ENABLED": "false",
    "KILL_SWITCH": "false",
    "PROMPTS_PER_RUN": "4",
    "MAX_DAILY_CALLS_PER_PROVIDER": "8",
    "WORKERS_AI_ENABLED": "false",
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "OSIRIS_GATEWAY_ENABLED": "false",
    "OSIRIS_GATEWAY_BASE_URL": "https://ai.osiris-code.com/v1",
    "OSIRIS_GATEWAY_MODEL": "",
    "OSIRIS_MEMORY_ENABLED": "false",
    "OSIRIS_MEMORY_BRIDGE_URL": "",
    "OPENROUTER_ENABLED": "true",
    "OPENROUTER_MODEL": "google/gemma-4-26b-a4b-it:free",
    "OSIRIS_ENABLED": "true",
    "OSIRIS_BASE_URL": "https://osirisai.live",
    "OSIRIS_SOURCE_KEYS": "stats,flights,satellites,space_weather,earthquakes,fires,weather,air_quality,radar,conflicts,frontlines,gdelt,country_risk,news,live_news,markets,crypto,scm_suppliers,cctv,infrastructure,maritime,cyber_threats,cyber_attacks,malware",
    "OSIRIS_SOURCE_CADENCES_JSON": "{\"stats\":24,\"flights\":6,\"satellites\":12,\"space_weather\":6,\"earthquakes\":3,\"fires\":6,\"weather\":3,\"air_quality\":6,\"radar\":6,\"conflicts\":6,\"frontlines\":12,\"gdelt\":6,\"country_risk\":24,\"news\":3,\"live_news\":3,\"markets\":3,\"crypto\":3,\"scm_suppliers\":24,\"cctv\":12,\"infrastructure\":12,\"maritime\":6,\"cyber_threats\":6,\"cyber_attacks\":6,\"malware\":6}",
    "MAX_DAILY_CALLS_PER_OSIRIS_SOURCE": "8",
    "PUBLIC_DATA_ENABLED": "false",
    "MAX_DAILY_CALLS_PER_PUBLIC_SOURCE": "4",
    "EUROSTAT_ENABLED": "false",
    "EUROSTAT_QUERIES_JSON": "[]",
    "BASE_PT_ENABLED": "false",
    "BASE_PT_QUERIES_JSON": "[]",
    "OPENALEX_ENABLED": "false",
    "OPENALEX_QUERIES_JSON": "[]",
    "OPENAI_ENABLED": "false",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "GEMINI_ENABLED": "false",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "PERPLEXITY_ENABLED": "false",
    "PERPLEXITY_MODEL": "sonar",
    "ANTHROPIC_ENABLED": "false",
    "ANTHROPIC_MODEL": "",
    "ZERO_COST_MODE": "true",
    "ZERO_COST_OBSERVE_ACTIVATION": "true",
    "OPENROUTER_FALLBACK_MODELS_JSON": "[\"qwen/qwen3.8-27b:free\",\"nvidia/nemotron-3-super-120b-a12b:free\",\"nvidia/nemotron-3-ultra-550b-a55b:free\",\"z-ai/glm-5.2:free\",\"thinkingmachines/inkling-small:free\",\"nex-agi/nex-n2.5-pro:free\",\"inclusionai/ling-3.0-flash-fin:free\",\"poolside/laguna-s-2.1:free\"]",
    "SEARCH_VISIBILITY_ENABLED": "true",
    "GOOGLE_SEARCH_CONSOLE_ENABLED": "true",
    "GOOGLE_SEARCH_CONSOLE_PROPERTY": "sc-domain:maison-jf.com",
    "GOOGLE_SEARCH_CONSOLE_WINDOW_DAYS": "28",
    "GOOGLE_SEARCH_CONSOLE_LAG_DAYS": "3",
    "MAX_DAILY_CALLS_PER_SEARCH_SOURCE": "10",
    "SEARCH_VISIBILITY_PROBES_ENABLED": "true",
    "VISIBILITY_PROBES_PER_RUN": "1",
    "MAX_DAILY_CALLS_PER_VISIBILITY_PROVIDER": "1",
    "BING_WEBMASTER_ENABLED": "false",
    "BING_WEBMASTER_SITE_URL": "https://maison-jf.com/"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "GROWTH_DB",
      "database_name": "maison-growth-engine",
      "database_id": "fb49d911-fed3-4c50-8424-231aae391814"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INTELLIGENCE_QUEUE",
        "queue": "maison-intelligence"
      }
    ],
    "consumers": [
      {
        "queue": "maison-intelligence",
        "max_batch_size": 2,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 300,
        "dead_letter_queue": "maison-intelligence-dlq",
        "max_concurrency": 1
      }
    ]
  }
}
